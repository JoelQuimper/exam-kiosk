<Window x:Class="ExamKiosk.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exam Kiosk"
        Width="920"
        Height="620"
        MinWidth="720"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#176B5B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="22,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#105247" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#9AA4A1" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#12332E" Padding="36,24">
            <StackPanel>
                <TextBlock Foreground="#9FD4C8"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Text="EXAM KIOSK" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Text="Available exams" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="36,32">
            <Border MaxWidth="760"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Background="White"
                    BorderBrush="#D8DEDC"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,28,0">
                        <Border Width="104"
                                Padding="9,5"
                                HorizontalAlignment="Left"
                                Background="#E4F2EE"
                                CornerRadius="4">
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="#176B5B"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Text="READY" />
                        </Border>
                        <TextBlock Margin="0,18,0,0"
                                   Foreground="#18211F"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Text="Bogus exam" />
                        <TextBlock Margin="0,9,0,0"
                                   Foreground="#53605D"
                                   FontSize="15"
                                   Text="Assigned Access feasibility test"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,20,0,0"
                                   Foreground="#68736F"
                                   FontSize="13"
                                   Text="This prototype applies a local kiosk profile and restarts the device."
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Button x:Name="StartExamButton"
                            Grid.Column="1"
                            MinWidth="132"
                            VerticalAlignment="Center"
                            Click="StartExamButton_Click"
                            Content="Switch to exam" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="#D8DEDC"
                BorderThickness="0,1,0,0"
                Padding="36,18">
            <TextBlock x:Name="StatusText"
                       Foreground="#53605D"
                       FontSize="13"
                       Text="No exam is running." />
        </Border>
    </Grid>
</Window>
