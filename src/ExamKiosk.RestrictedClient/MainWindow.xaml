<Window x:Class="ExamKiosk.RestrictedClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Exam Kiosk"
        Width="1180"
        Height="760"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <wv2:WebView2 x:Name="Browser"
                      Visibility="Collapsed" />

        <Grid x:Name="StatusPanel"
              Background="#F5F7FB">
            <StackPanel Width="520"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock x:Name="StatusHeading"
                           Foreground="#14213D"
                           FontSize="30"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="StatusMessage"
                           Margin="0,16,0,0"
                           Foreground="#62708A"
                           FontSize="15"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <Button x:Name="RetryButton"
                        Width="140"
                        Margin="0,24,0,0"
                        Padding="18,11"
                        HorizontalAlignment="Center"
                        Background="#2457E6"
                        BorderThickness="0"
                        Foreground="White"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Click="RetryButton_Click"
                        Content="Retry"
                        Visibility="Collapsed" />
                <Button x:Name="NativeFinishButton"
                        Width="160"
                        Margin="0,12,0,0"
                        Padding="18,11"
                        HorizontalAlignment="Center"
                        Background="#B42318"
                        BorderThickness="0"
                        Foreground="White"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Click="NativeFinishButton_Click"
                        Content="Exam done"
                        Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
