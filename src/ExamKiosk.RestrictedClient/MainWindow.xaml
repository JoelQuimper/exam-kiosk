<Window x:Class="ExamKiosk.RestrictedClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exam Kiosk"
        Width="320"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#F5F7FB"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Border BorderBrush="#D8DEEA"
            BorderThickness="1,0,0,0"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <Border Width="52"
                        Height="52"
                        HorizontalAlignment="Left"
                        Background="#2457E6"
                        CornerRadius="12">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               Text="EK" />
                </Border>
                <TextBlock x:Name="StatusHeading"
                           Margin="0,20,0,0"
                           Foreground="#14213D"
                           FontSize="26"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="ExamTitle"
                           Margin="0,16,0,0"
                           Foreground="#14213D"
                           FontSize="19"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
                <TextBlock x:Name="StatusMessage"
                           Margin="0,12,0,0"
                           Foreground="#62708A"
                           FontSize="15"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="2">
                <Button x:Name="OpenExamButton"
                        Margin="0,0,0,12"
                        Padding="18,12"
                        Background="#2457E6"
                        BorderThickness="0"
                        Foreground="White"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Click="OpenExamButton_Click"
                        Visibility="Collapsed" />
                <Button x:Name="RetryButton"
                        Margin="0,0,0,12"
                        Padding="18,12"
                        Background="#2457E6"
                        BorderThickness="0"
                        Foreground="White"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Click="RetryButton_Click"
                        Visibility="Collapsed" />
                <Button x:Name="FinishButton"
                        Padding="18,12"
                        Background="#B42318"
                        BorderThickness="0"
                        Foreground="White"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Click="FinishButton_Click"
                        Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
