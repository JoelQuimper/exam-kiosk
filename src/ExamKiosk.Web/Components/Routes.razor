@inject IStringLocalizer<SharedResource> Localizer

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData">
            <Authorizing>
                <main class="page-shell status-page">
                    <p>@Localizer["CheckingAccount"]</p>
                </main>
            </Authorizing>
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <PageTitle>@Localizer["PageNotFound"]</PageTitle>
        <main class="page-shell status-page">
            <p class="eyebrow">404</p>
            <h1>@Localizer["PageNotFound"]</h1>
            <p>@Localizer["RequestedPageDoesNotExist"]</p>
            <a class="button button-primary" href="/exams">@Localizer["ReturnHome"]</a>
        </main>
    </NotFound>
</Router>