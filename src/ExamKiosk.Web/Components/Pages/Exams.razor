@page "/exams"
@attribute [Authorize]
@inject IExamAssignmentService ExamAssignmentService
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["MyExams"]</PageTitle>

<main class="page-shell">
    <header class="app-header">
        <a class="brand" href="/exams" aria-label="@Localizer["ExamKioskHome"]">
            <span class="brand-mark" aria-hidden="true">EK</span>
            <span>Exam Kiosk</span>
        </a>
        <div class="account-menu">
            <div class="account-copy">
                <span class="account-name">@DisplayName</span>
                <span class="account-label">@Localizer["StudentAccount"]</span>
            </div>
            <form action="/authentication/logout" method="post">
                <AntiforgeryToken />
                <button class="button button-secondary" type="submit">@Localizer["SignOut"]</button>
            </form>
        </div>
    </header>

    <section class="catalog-heading">
        <p class="eyebrow">@Localizer["ExamDashboard"]</p>
        <h1>@Localizer["Greeting", GreetingName]</h1>
        <p>@Localizer["SelectExam"]</p>
    </section>

    <section class="exam-grid" aria-label="@Localizer["AvailableExams"]">
        @if (AssignedExams.Count == 0)
        {
            <article class="exam-card empty-exam-card">
                <div class="exam-copy">
                    <h2>@Localizer["NoExamsAssigned"]</h2>
                    <p class="exam-description">@Localizer["NoExamsAssignedDetails"]</p>
                </div>
            </article>
        }
        @foreach (var assignment in AssignedExams)
        {
            <article class="exam-card">
                <div class="exam-summary">
                    <div class="exam-glyph" aria-hidden="true">@GetExamGlyph(assignment.Exam.Icon)</div>
                    <div class="exam-copy">
                        <div class="exam-card-top">
                            <span class="status-badge">@Localizer["Ready"]</span>
                        </div>
                        <h2>@assignment.Exam.Title</h2>
                    </div>
                </div>
                <dl class="exam-details">
                    <div>
                        <dt>@Localizer["Available"]</dt>
                        <dd>@Localizer["AvailableNow"]</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Tools"]</dt>
                        <dd>
                            @if (assignment.Tools.Count == 0)
                            {
                                <span>@Localizer["None"]</span>
                            }
                            else
                            {
                                <ul class="exam-tools">
                                    @foreach (var tool in assignment.Tools)
                                    {
                                        <li>@GetToolDisplayName(tool)</li>
                                    }
                                </ul>
                            }
                        </dd>
                    </div>
                </dl>
                <div class="exam-controls">
                    <button class="button button-primary exam-action launcher-start-exam"
                            data-assignment-id="@assignment.AssignmentId"
                            type="button"
                            disabled>
                        @Localizer["StartExam"]
                    </button>
                </div>
            </article>
        }
    </section>
    @if (AssignedExams.Count > 0)
    {
        <form id="launcher-antiforgery" hidden>
            <AntiforgeryToken />
        </form>
        <p class="phase-note launcher-status"
           id="launcher-status"
           aria-live="polite"
           data-connecting="@(Localizer["LauncherConnecting"])"
           data-direct-browser="@(Localizer["LauncherDirectBrowser"])"
           data-ready="@(Localizer["LauncherDeviceReady"])"
           data-starting="@(Localizer["LauncherStarting"])"
           data-unavailable="@(Localizer["LauncherUnavailable"])">
            @Localizer["LauncherConnecting"]
        </p>
    }
</main>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;

    private IReadOnlyList<AssignedExam> AssignedExams { get; set; } = [];

    private string DisplayName { get; set; } = string.Empty;
    private string GreetingName { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateTask).User;
        var userPrincipalName = AuthenticatedUpnResolver.Resolve(user);
        AssignedExams = userPrincipalName is null
            ? []
            : ExamAssignmentService.GetAssignments(userPrincipalName);
        DisplayName = user.FindFirstValue("name")
            ?? user.Identity?.Name
            ?? Localizer["Student"];
        GreetingName = user.FindFirstValue(ClaimTypes.GivenName)
            ?? user.FindFirstValue("given_name")
            ?? DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()
            ?? Localizer["Student"];
    }

    private static string GetExamGlyph(string icon) =>
        icon switch
        {
            "calculator" => "+/-",
            "chart" => "|||",
            _ => "EX",
        };

    private string GetToolDisplayName(ToolDefinition tool) =>
        tool.ToolId == "windows-calculator"
            ? Localizer["Calculator"]
            : tool.DisplayName;
}
