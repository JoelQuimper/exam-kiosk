@page "/"
@page "/exams"
@page "/launcher"
@attribute [Authorize]
@inject IExamCatalog ExamCatalog
@inject IStringLocalizer<SharedResource> Localizer
@inject NavigationManager Navigation

<PageTitle>@Localizer["MyExams"]</PageTitle>

<main class="page-shell">
    <header class="app-header">
        <a class="brand" href="/" aria-label="@Localizer["ExamKioskHome"]">
            <span class="brand-mark" aria-hidden="true">EK</span>
            <span>Exam Kiosk</span>
        </a>
        <div class="account-menu">
            <div class="account-copy">
                <span class="account-name">@DisplayName</span>
                <span class="account-label">@Localizer["StudentAccount"]</span>
            </div>
            <form action="/authentication/logout" method="post">
                <AntiforgeryToken />
                <button class="button button-secondary" type="submit">@Localizer["SignOut"]</button>
            </form>
        </div>
    </header>

    <section class="catalog-heading">
        <p class="eyebrow">@Localizer["ExamDashboard"]</p>
        <h1>@Localizer["Greeting", GreetingName]</h1>
        <p>@Localizer["SelectExam"]</p>
    </section>

    <section class="exam-grid" aria-label="@Localizer["AvailableExams"]">
        @foreach (var exam in AssignedExams)
        {
            <article class="exam-card">
                <div class="exam-summary">
                    <div class="exam-glyph" aria-hidden="true">+/-</div>
                    <div class="exam-copy">
                        <div class="exam-card-top">
                            <span class="status-badge">@exam.Status</span>
                            <span class="exam-duration">@Localizer["DurationMinutes", exam.DurationMinutes]</span>
                        </div>
                        <p class="exam-course">@exam.Course</p>
                        <h2>@exam.Title</h2>
                        <p class="exam-description">@exam.Description</p>
                    </div>
                </div>
                <dl class="exam-details">
                    <div>
                        <dt>@Localizer["Available"]</dt>
                        <dd>@exam.AvailabilityLabel</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Tools"]</dt>
                        <dd>
                            @if (exam.AllowedTools.Count == 0)
                            {
                                <span>@Localizer["None"]</span>
                            }
                            else
                            {
                                <ul class="exam-tools">
                                    @foreach (var tool in exam.AllowedTools)
                                    {
                                        <li>@tool</li>
                                    }
                                </ul>
                            }
                        </dd>
                    </div>
                </dl>
                <div class="exam-controls">
                    <button class="button button-primary exam-action"
                            id="@(IsLauncher ? "launcher-start-exam" : null)"
                            data-exam-title="@(IsLauncher ? exam.Title : null)"
                            type="button"
                            disabled>
                        @Localizer["StartExam"]
                    </button>
                    @if (IsLauncher)
                    {
                        <p class="phase-note"
                           id="launcher-status"
                           aria-live="polite"
                           data-connecting="@(Localizer["LauncherConnecting"])"
                           data-direct-browser="@(Localizer["LauncherDirectBrowser"])"
                           data-ready="@(Localizer["LauncherDeviceReady"])"
                           data-starting="@(Localizer["LauncherStarting"])"
                           data-unavailable="@(Localizer["LauncherUnavailable"])">
                            @Localizer["LauncherConnecting"]
                        </p>
                    }
                    else
                    {
                        <p class="phase-note">@Localizer["LaunchPhaseNote"]</p>
                    }
                </div>
            </article>
        }
    </section>
</main>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;

    private IReadOnlyList<ExamSummary> AssignedExams => ExamCatalog.GetAssignedExams();
    private bool IsLauncher =>
        Navigation.ToBaseRelativePath(Navigation.Uri)
            .Split('?', '#')[0]
            .Equals("launcher", StringComparison.OrdinalIgnoreCase);

    private string DisplayName { get; set; } = string.Empty;
    private string GreetingName { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateTask).User;
        DisplayName = user.FindFirstValue("name")
            ?? user.Identity?.Name
            ?? Localizer["Student"];
        GreetingName = user.FindFirstValue(ClaimTypes.GivenName)
            ?? user.FindFirstValue("given_name")
            ?? DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()
            ?? Localizer["Student"];
    }
}
