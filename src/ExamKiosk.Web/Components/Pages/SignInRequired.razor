@page "/sign-in-required"
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["SignInRequired"]</PageTitle>

<main class="page-shell status-page">
    <p class="eyebrow">@Localizer["SignInRequired"]</p>
    <h1>@Localizer["MustSignInToViewExams"]</h1>
    <p>@Localizer["SchoolAccountRequired"]</p>
    <a class="button button-primary" href="/authentication/login?returnUrl=%2F">
        @Localizer["SignIn"]
    </a>
</main>
