@page "/exam-session"
@attribute [Authorize]
@inject IExamCatalog ExamCatalog
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["ExamInProgress"]</PageTitle>

<main class="page-shell">
    <header class="app-header">
        <div class="brand">
            <span class="brand-mark" aria-hidden="true">EK</span>
            <span>Exam Kiosk</span>
        </div>
    </header>

    <section class="catalog-heading">
        <p class="eyebrow">@Localizer["ExamInProgress"]</p>
        <h1>@(Exam?.Title ?? Localizer["ExamInProgress"])</h1>
        <p>@Localizer["ExamSessionInstructions"]</p>
    </section>

    <section class="exam-grid" aria-label="@Localizer["ExamInProgress"]">
        <article class="exam-card">
            @if (Exam is not null)
            {
                <div class="exam-summary">
                    <div class="exam-glyph" aria-hidden="true">+/-</div>
                    <div class="exam-copy">
                        <div class="exam-card-top">
                            <span class="status-badge">@Exam.Status</span>
                            <span class="exam-duration">@Localizer["DurationMinutes", Exam.DurationMinutes]</span>
                        </div>
                        <p class="exam-course">@Exam.Course</p>
                        <h2>@Exam.Title</h2>
                        <p class="exam-description">@Exam.Description</p>
                    </div>
                </div>
                <dl class="exam-details">
                    <div>
                        <dt>@Localizer["Tools"]</dt>
                        <dd>
                            @if (Exam.AllowedTools.Count == 0)
                            {
                                <span>@Localizer["None"]</span>
                            }
                            else
                            {
                                <ul class="exam-tools">
                                    @foreach (var tool in Exam.AllowedTools)
                                    {
                                        <li>@tool</li>
                                    }
                                </ul>
                            }
                        </dd>
                    </div>
                </dl>
            }
            <div class="exam-controls session-controls">
                <div class="session-actions">
                    <button class="button button-primary"
                            id="session-open-exam"
                            type="button"
                            disabled>
                        @Localizer["OpenExam"]
                    </button>
                    <button class="button button-danger"
                            id="session-finish-exam"
                            type="button"
                            disabled>
                        @Localizer["ExamDone"]
                    </button>
                </div>
                <p class="phase-note"
                   id="session-status"
                   aria-live="polite"
                   data-connecting="@(Localizer["SessionConnecting"])"
                   data-direct-browser="@(Localizer["SessionDirectBrowser"])"
                   data-finishing="@(Localizer["SessionFinishing"])"
                   data-opening="@(Localizer["SessionOpening"])"
                   data-ready="@(Localizer["SessionReady"])"
                   data-unavailable="@(Localizer["SessionUnavailable"])">
                    @Localizer["SessionConnecting"]
                </p>
            </div>
        </article>
    </section>
</main>

@code {
    private ExamSummary? Exam { get; set; }

    protected override void OnInitialized()
    {
        Exam = ExamCatalog.GetAssignedExams().FirstOrDefault();
    }
}
